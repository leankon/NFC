# ---------------------------------------------------------------
# Supabase  (Dashboard -> Project Settings -> API)
# ---------------------------------------------------------------
# Solo se usa en el servidor, por eso NO lleva el prefijo NEXT_PUBLIC_.
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# ¡SECRETA! Solo se usa en el servidor. Nunca la expongas al cliente.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# ---------------------------------------------------------------
# Acceso al panel /admin
# ---------------------------------------------------------------
ADMIN_PASSWORD=cambiame-por-algo-largo

# Firma de las cookies de sesión (mínimo 16 caracteres).
# Generala con:  openssl rand -base64 32
SESSION_SECRET=cambiame-tambien-por-algo-random-largo

# ---------------------------------------------------------------
# Opcionales
# ---------------------------------------------------------------
# Zona horaria del negocio: define la "hora" y el "día" de cada click.
APP_TIMEZONE=America/Argentina/Buenos_Aires
# URL pública, para los links que se le entregan a cada local.
# En Vercel se detecta sola; definila si usás dominio propio.
NEXT_PUBLIC_SITE_URL=https://tu-dominio.com
